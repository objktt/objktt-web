# Google Analytics 4 Measurement ID
# Example: G-ABCDEF1234
VITE_GA_MEASUREMENT_ID=

# Shopify Storefront API
# Get these from Shopify Admin → Apps → your custom app → API credentials
# Domain: e.g. objktt.myshopify.com
VITE_SHOPIFY_STORE_DOMAIN=
# Storefront API access token (public, safe to expose in frontend)
# Starts with shpat_ or atkn_
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Storefront API version, e.g. 2024-10
VITE_SHOPIFY_API_VERSION=2024-10
# Blog handle used for the Notices page (Shopify Admin → Content → Blog posts)
VITE_SHOPIFY_NOTICES_BLOG_HANDLE=notices
# Metaobject type used for the FAQ page (Settings → Custom data → Metaobjects)
VITE_SHOPIFY_FAQ_METAOBJECT_TYPE=faq

# Unsplash API
# Get from https://unsplash.com/oauth/applications → your app → Access Key
# Only the Access Key (public/client-side). Never put the Secret key here.
VITE_UNSPLASH_ACCESS_KEY=

# Brevo (server-side, used by /api/contact serverless function)
# Set in Vercel project env vars — NOT prefixed with VITE_
# BREVO_API_KEY=
# CONTACT_TO_EMAIL=hello@objktt.kr     # optional override
# CONTACT_FROM_EMAIL=hello@objktt.kr   # must be a verified sender on Brevo
